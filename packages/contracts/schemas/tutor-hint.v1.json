{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.local/contracts/tutor-hint.v1.json",
  "title": "TutorHintResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "provider", "model", "level", "prompt", "next_step", "requires_child_response", "direct_answer", "cost_cents"],
  "properties": {
    "schema_version": {"const": "tutor-hint.v1"},
    "policy_version": {"const": "offline-tutor-policy.v1"},
    "provider": {"const": "local-policy"},
    "model": {"const": "rules-v1"},
    "level": {"type": "integer", "minimum": 1, "maximum": 3},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 500},
    "next_step": {"type": "string", "minLength": 1, "maxLength": 500},
    "requires_child_response": {"const": true},
    "direct_answer": {"type": "null"},
    "cost_cents": {"const": 0}
  }
}
