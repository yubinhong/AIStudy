{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.local/contracts/image-analysis-job.v1.json",
  "title": "ImageAnalysisJobReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "capture_id", "household_id", "child_id", "status", "attempt",
    "sanitization_schema_version", "sanitized_derivative_sha256", "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "capture_id": {"type": "string", "format": "uuid"},
    "household_id": {"type": "string", "format": "uuid"},
    "child_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked"]},
    "attempt": {"type": "integer", "minimum": 0},
    "sanitization_schema_version": {"const": "privacy-sanitization.v1"},
    "sanitized_derivative_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "extraction_id": {"type": ["string", "null"], "format": "uuid"},
    "error_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
  }
}
