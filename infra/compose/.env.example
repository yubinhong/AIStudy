# Copy to infra/compose/.env. Compose loads this file automatically.
# Keep infra/compose/.env uncommitted.
# DATABASE_URL must use the Compose service name "postgres", not 127.0.0.1.
POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql+psycopg://study:change_this_postgres_password@postgres:5432/study

POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=change_this_minio_password
CAPTURE_BUCKET=study-captures-local

# API uses PostgreSQL accounts and revocable sessions in Compose.
# The empty database bootstrap account is admin/admin123456 and must be changed
# from the server host before household data can be read.
STUDY_COOKIE_SECURE=false
STUDY_CAPTURE_UPLOAD_CONCURRENCY=4
STUDY_CAPTURE_UPLOAD_TIMEOUT_SECONDS=120

# Set true to start llama.cpp with the local Qwen3.5-4B vision model and route
# every configured NewAPI-compatible AI request to it. When false, the API uses
# the cloud/self-hosted NewAPI settings below. The local service stays idle.
STUDY_LOCAL_MODEL_ENABLED=false
STUDY_LOCAL_MODEL_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b9603
STUDY_LOCAL_MODEL_HF_REPO=bjivanovich/Qwen3.5-4B-Vision-GGUF
STUDY_LOCAL_MODEL_MODEL_FILE=Qwen3.5-4B.Q4_K_M.gguf
STUDY_LOCAL_MODEL_MMPROJ_FILE=Qwen3.5-4B.BF16-mmproj.gguf
STUDY_LOCAL_MODEL_NAME=Qwen3.5-4B-Q4_K_M
STUDY_LOCAL_MODEL_BASE_URL=http://local-model:8080/v1
STUDY_LOCAL_MODEL_API_KEY=study-local-model
STUDY_LOCAL_MODEL_TIMEOUT_SECONDS=600
STUDY_LOCAL_MODEL_MAX_RESPONSE_BYTES=262144
STUDY_LOCAL_MODEL_MAX_IMAGE_BYTES=600000
STUDY_LOCAL_MODEL_MAX_OUTPUT_TOKENS=2048
STUDY_LOCAL_MODEL_CONTEXT_SIZE=8192
STUDY_LOCAL_MODEL_PARALLEL=1
# Optional download-only proxy for hosts where containers cannot reach Hugging
# Face directly. Keep empty when direct outbound HTTPS works.
STUDY_LOCAL_MODEL_PROXY_URL=

# Keep false until the NewAPI endpoint, key and vision model are verified.
STUDY_NEWAPI_ENABLED=false
# Host NewAPI example: http://host.docker.internal:3000
# Remote NewAPI example: https://newapi.example.invalid
STUDY_NEWAPI_BASE_URL=http://host.docker.internal:3000
STUDY_NEWAPI_API_KEY=replace_with_local_newapi_key
STUDY_NEWAPI_VISION_MODEL=replace_with_vision_model
STUDY_NEWAPI_TIMEOUT_SECONDS=30
STUDY_NEWAPI_MAX_RESPONSE_BYTES=262144
# Sanitized images larger than this are downscaled and metadata-free JPEG
# encoded in memory before base64 transport to avoid gateway request limits.
STUDY_NEWAPI_MAX_IMAGE_BYTES=600000
# Default is study-api/0.5. Keep a short printable ASCII value; this avoids
# Cloudflare blocking Python's default urllib client signature.
STUDY_NEWAPI_USER_AGENT=study-api/0.5
IMAGE_ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=2
CURRICULUM_ANALYSIS_POLL_INTERVAL_SECONDS=2
DATA_LIFECYCLE_POLL_INTERVAL_SECONDS=300
# Pause only for lifecycle incident investigation. Retention remains fixed at 180 days.
LEARNING_HISTORY_CLEANUP_ENABLED=true

# Child English stays locked until an approved provider is implemented.
# The repository ships only the disabled provider; fake is test-injected only.
STUDY_ENGLISH_LIVE_ENABLED=false
STUDY_ENGLISH_LIVE_PROVIDER=disabled
STUDY_ENGLISH_LIVE_CONSENT_VERSION=english-audio-consent.v1
