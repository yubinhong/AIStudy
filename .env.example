# Local-only defaults. Never put production or real child data here.
POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=study_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://study:study_local_only@127.0.0.1:5432/study
REDIS_PORT=6379
MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
CAPTURE_BUCKET=study-captures-local
CAPTURE_UPLOAD_TTL_SECONDS=300
# Image-baked, SHA-256-verified PaddleOCR model root. The API never downloads or updates models.
PADDLE_MODEL_ROOT=/opt/study/models
