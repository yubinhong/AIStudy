# Local-only defaults. Never put production or real child data here.
POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=study_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://study:study_local_only@127.0.0.1:5432/study
REDIS_PORT=6379
MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
# Explicit local durable mode: API and the one-shot/watch OCR Worker share PostgreSQL.
STUDY_API_LEARNING_REPOSITORY=postgres
STUDY_API_CURRICULUM_REPOSITORY=postgres
STUDY_API_OCR_QUEUE=postgres
STUDY_API_OCR_RESULTS=postgres
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
CAPTURE_BUCKET=study-captures-local
CAPTURE_UPLOAD_TTL_SECONDS=300
# Image-baked, SHA-256-verified PaddleOCR model root. The API never downloads or updates models.
PADDLE_MODEL_ROOT=/opt/study/models
# Account/password authentication always uses revocable sessions.
STUDY_API_AUTH_REPOSITORY=postgres
STUDY_COOKIE_SECURE=false
# NewAPI/OpenAI-compatible gateway. Keep disabled until your own gateway is ready.
STUDY_NEWAPI_ENABLED=false
STUDY_NEWAPI_BASE_URL=http://127.0.0.1:3000
STUDY_NEWAPI_API_KEY=replace_with_local_newapi_key
STUDY_NEWAPI_VISION_MODEL=replace_with_vision_model
STUDY_NEWAPI_TIMEOUT_SECONDS=30
STUDY_NEWAPI_MAX_RESPONSE_BYTES=262144
STUDY_NEWAPI_MAX_IMAGE_BYTES=600000
IMAGE_ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=2
CURRICULUM_ANALYSIS_POLL_INTERVAL_SECONDS=2
